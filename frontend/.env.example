# ICC-CNS 2027 Frontend Environment Variables
# In production (e.g. Vercel), set this to your deployed backend API URL (e.g. https://<render-service>.onrender.com/api)
# In local development, leaving this unset defaults automatically to '/api' (proxied by Vite to localhost:5000)
VITE_API_BASE_URL=http://localhost:5000/api
